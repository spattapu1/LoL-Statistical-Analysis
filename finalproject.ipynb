    ")\n",
    "\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "dt = DecisionTreeClassifier(max_depth=4, criterion='entropy')\n",
    "dt.fit(X_train, y_train)\n",
    "\n",
    "\n",
    "from sklearn.tree import plot_tree\n",
